<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\G15SystemMonitor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LibreHardwareMonitor\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="installer\**\*.cs" />
    <EmbeddedResource Remove="LibreHardwareMonitor\**\*" />
    <EmbeddedResource Include="assets\G15SystemMonitor.ico" LogicalName="G15Dashboard.AppIcon" />
    <InternalsVisibleTo Include="G15Dashboard.Tests" />
    <Content Include="tools\PresentMon.exe" Link="PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LCD-SDK\Lib\x64\LogitechLcd.dll" Link="LogitechLcd.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LCD-SDK\Lib\x64\LogitechLcd.dll')" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
